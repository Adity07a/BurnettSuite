# Copy to .env and fill the credentials. Do not commit .env.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DB_NAME=ai_interview_db
DB_ENGINE=sqlite
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=us-east-1
# Supported defaults: google.gemma-3-4b-it, nvidia.nemotron-super-3-120b, zai.glm-4.7-flash
BEDROCK_MODEL_ID=zai.glm-4.7-flash
BEDROCK_ASSISTANT_MODEL_ID=nvidia.nemotron-super-3-120b
BEDROCK_TIMEOUT_SECONDS=60
GEMINI_API_KEY=
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AI_LOG_LEVEL=INFO
# Enable secure cookies after configuring production HTTPS.
DJANGO_SECURE_COOKIES=false
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SECURE_HSTS_SECONDS=0
