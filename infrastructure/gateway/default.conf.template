upstream interview_backend {
    server interview-api:8000;
}
upstream resume_backend {
    server resume-api:8000;
}
upstream people_backend {
    server people-api:8000;
}

map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    '' $scheme;
}

server {
    listen 80 default_server;
    server_name ${PLATFORM_HOST};
    root /usr/share/nginx/html/platform;
    index index.html;

    location = /health { return 200 'healthy\n'; add_header Content-Type text/plain; }
    location /api/suite-auth/ {
        proxy_pass http://interview_backend/api/users/suite-auth/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
    }
    location /suite-assets/ { alias /usr/share/nginx/html/suite-assets/; }
    location / { try_files $uri $uri/ /index.html; }
}
server {
    listen 80;
    listen 8081;
    server_name ${INTERVIEW_HOST};
    root /usr/share/nginx/html/interview;
    index index.html;
    client_max_body_size 10m;

    location /suite-assets/ { alias /usr/share/nginx/html/suite-assets/; }
    location /api/suite-auth/ {
        proxy_pass http://interview_backend/api/users/suite-auth/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
    }
    location /api/ { proxy_pass http://interview_backend; proxy_set_header Host $host; proxy_set_header X-Real-IP $remote_addr; proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for; proxy_set_header X-Forwarded-Proto $forwarded_proto; }
    location /users/ { proxy_pass http://interview_backend; proxy_set_header Host $host; proxy_set_header X-Real-IP $remote_addr; proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for; proxy_set_header X-Forwarded-Proto $forwarded_proto; }
    location /media/ { alias /srv/interview-media/; add_header X-Content-Type-Options nosniff; }
    location / { try_files $uri $uri/ /index.html; }
}
server {
    listen 80;
    listen 8082;
    server_name ${RESUME_HOST};
    root /usr/share/nginx/html/resume;
    index index.html;
    client_max_body_size 10m;

    location /suite-assets/ { alias /usr/share/nginx/html/suite-assets/; }
    location /api/suite-auth/ {
        proxy_pass http://interview_backend/api/users/suite-auth/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
    }
    location /api/ { proxy_pass http://resume_backend; proxy_set_header Host $host; proxy_set_header X-Real-IP $remote_addr; proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for; proxy_set_header X-Forwarded-Proto $forwarded_proto; }
    location / { try_files $uri $uri/ /index.html; }
}

