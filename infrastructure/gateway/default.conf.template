    }
    location /api/ { proxy_pass http://people_backend; proxy_set_header Host $host; proxy_set_header X-Real-IP $remote_addr; proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for; proxy_set_header X-Forwarded-Proto $forwarded_proto; }
    location / { try_files $uri $uri/ /index.html; }
