# ==============================================================================
# BurnettSuite Unified Environment Configuration
# ==============================================================================

# Core Django Settings
DEBUG=True
SECRET_KEY=django-insecure-burnettsuite-unified-secret-key-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (PostgreSQL default, falls back to db.sqlite3 if omitted)
DATABASE_URL=postgres://burnett_user:burnett_secret_password@localhost:5432/burnettsuite

# Redis & Background Workers
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# JWT Authentication
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# AI Services: Resume Creator (Ollama local inference)
OLLAMA_HOST=http://localhost:11434
RESUME_AI_MODEL=qwen2.5:3b

# AI Services: Interview Platform (AWS Bedrock & OpenAI fallback)
AWS_BEDROCK_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BEDROCK_DEFAULT_MODEL=zai.glm-4.7-flash
BEDROCK_ADVANCED_MODEL=nvidia.nemotron-super-3-120b
OPENAI_API_KEY=

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000/api
