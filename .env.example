# Copy to .env. Never commit real values.
HTTP_PORT=80
INTERVIEW_HTTP_PORT=8081
RESUME_HTTP_PORT=8082
PEOPLE_HTTP_PORT=8083
PUBLIC_SCHEME=http
PLATFORM_HOST=platform.localhost
INTERVIEW_HOST=interview.localhost
RESUME_HOST=resume.localhost
PEOPLE_HOST=people.localhost

# Generate independent high-entropy values for every secret.
INTERVIEW_SECRET_KEY=replace-with-a-long-random-value
RESUME_SECRET_KEY=replace-with-a-different-long-random-value
PEOPLE_SECRET_KEY=replace-with-another-long-random-value
AI_SERVICE_SHARED_TOKEN=replace-with-an-internal-service-token
SUITE_JWT_SIGNING_KEY=replace-with-a-long-random-suite-signing-key
SUITE_COOKIE_DOMAIN=
SUITE_COOKIE_SAMESITE=Lax

INTERVIEW_DB_NAME=interview
INTERVIEW_DB_USER=interview
INTERVIEW_DB_PASSWORD=replace-interview-db-password
RESUME_DB_NAME=resume
RESUME_DB_USER=resume
RESUME_DB_PASSWORD=replace-resume-db-password
PEOPLE_DB_NAME=people
PEOPLE_DB_USER=people
PEOPLE_DB_PASSWORD=replace-people-db-password
PEOPLE_DB_SSLMODE=disable

# Local demo accounts only. Never reuse this password in production.
DEMO_USER_PASSWORD=BurnettLocal!2026

# Enable these only after HTTPS is terminated by an ALB or trusted proxy.
SECURE_SSL_REDIRECT=false
SECURE_COOKIES=false

AWS_REGION=us-east-1
AWS_BEARER_TOKEN_BEDROCK=
BEDROCK_BASE_URL=
BEDROCK_PROJECT=default
BEDROCK_TIMEOUT_SECONDS=60
BEDROCK_MODEL_ID=zai.glm-4.7-flash
BEDROCK_ASSISTANT_MODEL_ID=nvidia.nemotron-super-3-120b
GEMINI_API_KEY=

# Bedrock is the default across all three applications. A single shared bearer
# token above is sufficient; product-specific keys remain optional overrides.
RESUME_AI_PROVIDER=bedrock
RESUME_AI_MODEL=zai.glm-4.7-flash
RESUME_AI_BASE_URL=
RESUME_AI_API_KEY=
RESUME_AI_TIMEOUT_SECONDS=180
# Optional offline provider settings (not started by the default Compose stack).
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:3b

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
PEOPLE_AI_PROVIDER=bedrock
PEOPLE_AI_API_KEY=
PEOPLE_AI_BASE_URL=
PEOPLE_AI_MODEL=zai.glm-4.7-flash
